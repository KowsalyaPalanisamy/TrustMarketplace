@page
@model SecureMarketplace.Pages.Products.DeleteModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Delete Product - Secure Marketplace</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card shadow">
                    <div class="card-header bg-danger text-white">
                        <h3>Delete Product</h3>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                        {
                            <div class="alert alert-danger">@Model.ErrorMessage</div>
                        }

                        @if (Model.Product != null)
                        {
                            <div class="alert alert-warning">
                                <h4>Are you sure you want to delete this product?</h4>
                                <hr />
                                <p><strong>Title:</strong> @Model.Product.Title</p>
                                <p><strong>Price:</strong> €@Model.Product.Price.ToString("F2")</p>
                                <p><strong>Created:</strong> @Model.Product.CreatedAt.ToString("MMMM dd, yyyy")</p>
                            </div>

                            <form method="post">
                                <input type="hidden" asp-for="Product.Id" />
                                <button type="submit" class="btn btn-danger">Yes, Delete</button>
                                <a href="/Products/Index" class="btn btn-secondary">Cancel</a>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>

@{
    Layout = null;
}