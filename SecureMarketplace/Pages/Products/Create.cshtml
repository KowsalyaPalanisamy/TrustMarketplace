@page
@using Microsoft.AspNetCore.Authorization
@model SecureMarketplace.Pages.Products.CreateModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Create Product - Secure Marketplace</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow">
                    <div class="card-header bg-success text-white">
                        <h3>Add New Product</h3>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                        {
                            <div class="alert alert-danger">@Model.ErrorMessage</div>
                        }
                        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                        {
                            <div class="alert alert-success">@Model.SuccessMessage</div>
                        }

                        <form method="post">
                            <div class="mb-3">
                                <label asp-for="Product.Title" class="form-label">Title</label>
                                <input asp-for="Product.Title" class="form-control" required />
                                <span asp-validation-for="Product.Title" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Product.Description" class="form-label">Description</label>
                                <textarea asp-for="Product.Description" class="form-control" rows="5" required></textarea>
                                <span asp-validation-for="Product.Description" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Product.Price" class="form-label">Price (€)</label>
                                <input asp-for="Product.Price" class="form-control" type="number" step="0.01" required />
                                <span asp-validation-for="Product.Price" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Product.ImageUrl" class="form-label">Image URL (optional)</label>
                                <input asp-for="Product.ImageUrl" class="form-control" />
                            </div>

                            <button type="submit" class="btn btn-success">Create Product</button>
                            <a href="/Products/Index" class="btn btn-secondary">Cancel</a>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>

@{
    Layout = null;
}