@page
@using Microsoft.AspNetCore.Authorization
@model SecureMarketplace.Pages.Products.SearchModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Search Products - Secure Marketplace</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container mt-4">
        <h1>Search Products</h1>
        
        <!-- VULNERABLE SEARCH FORM -->
        <form method="get" class="mb-4">
            <div class="input-group">
                <input type="text" name="searchTerm" class="form-control" 
                       placeholder="Search products..." value="@Model.SearchTerm">
                <button type="submit" class="btn btn-primary">Search</button>
            </div>
        </form>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }

        @if (Model.Products != null && Model.Products.Any())
        {
            <div class="row">
                @foreach (var product in Model.Products)
                {
                    <div class="col-md-4 mb-3">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">@product.Title</h5>
                                <p class="card-text">@product.Description</p>
                                <p class="text-primary">€@product.Price</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else if (!string.IsNullOrEmpty(Model.SearchTerm))
        {
            <p>No products found.</p>
        }
    </div>
</body>
</html>