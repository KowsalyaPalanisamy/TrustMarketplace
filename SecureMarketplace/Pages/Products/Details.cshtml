@page
@model SecureMarketplace.Pages.Products.DetailsModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@Model.Product?.Title - Secure Marketplace</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">Secure Marketplace</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/Products">Back to Products</a>
                    </li>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/Account/Logout">Logout</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        @if (Model.Product == null)
        {
            <div class="alert alert-danger">Product not found.</div>
        }
        else
        {
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h2>@Model.Product.Title</h2>
                </div>
                <div class="card-body">
                    <h4 class="text-primary">€@Model.Product.Price.ToString("F2")</h4>
                    <hr />
                    <h5>Description:</h5>
                    <p>@Model.Product.Description</p>
                    <hr />
                    <small class="text-muted">
                        Posted by: @Model.Product.SellerName<br />
                        Posted on: @Model.Product.CreatedAt.ToString("MMMM dd, yyyy")
                    </small>
                </div>
                <div class="card-footer">
                    <a href="/Products" class="btn btn-secondary">Back to List</a>
                </div>
            </div>
        }
    </div>
</body>
</html>

@{
    Layout = null;
}