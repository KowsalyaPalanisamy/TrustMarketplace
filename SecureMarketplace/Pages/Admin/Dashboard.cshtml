@page
@using Microsoft.AspNetCore.Identity
@using SecureMarketplace.Models
@inject UserManager<ApplicationUser> UserManager
@model SecureMarketplace.Pages.Admin.DashboardModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Admin Dashboard - Secure Marketplace</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">Secure Marketplace - Admin</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/Products">View Products</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Account/Logout">Logout</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <div class="row">
            <div class="col-md-12">
                <div class="alert alert-success">
                    <h3>Welcome, Admin!</h3>
                    <p>You have full control over the marketplace.</p>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-md-6">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white">
                        <h4><i class="fas fa-chart-bar"></i> Statistics</h4>
                    </div>
                    <div class="card-body">
                        <p><strong>Total Products:</strong> @Model.TotalProducts</p>
                        <p><strong>Total Users:</strong> @Model.TotalUsers</p>
                        <p><strong>Sellers:</strong> @Model.TotalSellers</p>
                        <p><strong>Buyers:</strong> @Model.TotalBuyers</p>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card shadow">
                    <div class="card-header bg-warning">
                        <h4><i class="fas fa-users"></i> Recent Users</h4>
                    </div>
                    <div class="card-body">
                        <ul class="list-group">
                            @foreach (var user in Model.RecentUsers)
                            {
                                <li class="list-group-item">
                                    <strong>@user.FullName</strong> - @user.Email
                                    <span class="badge bg-secondary float-end">@user.Role</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-md-12">
                <div class="card shadow">
                    <div class="card-header bg-danger text-white">
                        <h4><i class="fas fa-box"></i> All Products</h4>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Title</th>
                                        <th>Price</th>
                                        <th>Seller</th>
                                        <th>Created</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var product in Model.AllProducts)
                                    {
                                        <tr>
                                            <td>@product.Id</td>
                                            <td>@product.Title</td>
                                            <td>€@product.Price.ToString("F2")</td>
                                            <td>@product.SellerName</td>
                                            <td>@product.CreatedAt.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                <a href="/Products/Delete?id=@product.Id" class="btn btn-danger btn-sm" onclick="return confirm('Delete this product?')">Delete</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

@{
    Layout = null;
}